#!/bin/bash

# Deploys the generated site in docs/ to Firebase Hosting on Google Cloud,
# where it's served at https://gobyexample-cz.web.app. This replaces the
# original S3/CloudFront upload in tools/upload.
#
# Example pages are generated as *.html; "cleanUrls" in firebase.json serves
# them under their extension-less paths (e.g. /arrays), so links keep working.

set -e

FIREBASE="${FIREBASE:-firebase}"

$FIREBASE deploy --only hosting "$@"
